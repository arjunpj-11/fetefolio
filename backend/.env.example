NODE_ENV=development
PORT=5055
MONGODB_URI=mongodb://127.0.0.1:27017/the-programme
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
REDIS_URL=redis://127.0.0.1:6379
OTP_SECRET=replace-with-a-separate-32-character-random-secret
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Required for admin image uploads. Find these in Cloudinary Console > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_FROM=bookings@fetefolio.local
